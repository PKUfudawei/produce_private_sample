Universe = vanilla 
+ProjectName="cms.org.cern"
+JobFlavour = "testmatch"

Executable = ./main.sh
Arguments = fragment_DYto2Tau.py 1000 chain_RunIII2024Summer24wmLHEGS-RunIII2024Summer24NanoAOD.txt

should_transfer_files   = YES
transfer_input_files    = fragment_DYto2Tau.py, wmLHEGEN.sh, SIM.sh, DIGIPremix.sh, HLT.sh, RECO.sh, MiniAODv2.sh, NanoAODv9.sh, customizedNanoAOD.sh, chain_RunIII2024Summer24wmLHEGS-RunIII2024Summer24NanoAOD.txt
when_to_transfer_output = ON_EXIT_OR_EVICT
transfer_output_files   = MiniAODv2.root
transfer_output_remaps  = "MiniAODv2.root=miniaod-$(Process).root"
output_destination = root://eosuser.cern.ch//eos/user/d/dfu/private_production/DYto2Tau
MY.XRDCP_CREATE_DIR = True

use_x509userproxy = true
# x509userproxy = ~/.proxy

Error = $(Process).err
Output = $(Process).out
#Log = $(Cluster).log

Queue 1000
